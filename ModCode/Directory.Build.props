<Project>
  <!-- Copy Local.props.example to Local.props and set GameDir on your own computer. -->
  <Import Project="Local.props" Condition="Exists('Local.props')" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameAssemblyDir>$(GameDir)/MelonLoader/Managed</GameAssemblyDir>
    <GameAssemblyDir Condition="!Exists('$(GameAssemblyDir)/Assembly-CSharp.dll')">$(GameDir)/MelonLoader/Il2CppAssemblies</GameAssemblyDir>
  </PropertyGroup>

  <Target Name="CheckLocalGamePath" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameDir)' == ''" Text="Set GameDir in ModCode/Local.props (copy ModCode/Local.props.example first)." />
    <Error Condition="'$(GameDir)' != '' And !Exists('$(GameAssemblyDir)/Assembly-CSharp.dll')" Text="Assembly-CSharp.dll not found in MelonLoader/Managed or MelonLoader/Il2CppAssemblies under GameDir. Check the installation path." />
  </Target>

  <!-- Local game/loader references only; do not commit DLLs. -->
  <ItemGroup Condition="'$(GameDir)' != ''">
    <Reference Include="$(GameAssemblyDir)/Assembly-CSharp*.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)/MelonLoader/*.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)/MelonLoader/Managed/Il2Cpp*.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)/MelonLoader/Managed/Unhollower*.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)/MelonLoader/Managed/Unity*.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
