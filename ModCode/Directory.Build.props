<Project>
  <!-- Copy Local.props.example to Local.props and set GameDir on your own computer. -->
  <Import Project="Local.props" Condition="Exists('Local.props')" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameAssemblyDir>$(GameDir)/MelonLoader/Managed</GameAssemblyDir>
    <GameAssemblyDir Condition="!Exists('$(GameAssemblyDir)/Assembly-CSharp.dll')">$(GameDir)/MelonLoader/Il2CppAssemblies</GameAssemblyDir>
  </PropertyGroup>

  <!-- Some MelonLoader versions put loader/Harmony binaries in nested subdirectories,
       not in MelonLoader/ itself. Search only for these named DLLs to avoid pulling
       duplicate/irrelevant assemblies into the compiler. -->
  <ItemGroup Condition="'$(GameDir)' != ''">
    <_MelonLoaderDll Include="$(GameDir)/MelonLoader/**/MelonLoader.dll" />
    <_HarmonyDll Include="$(GameDir)/MelonLoader/**/0Harmony.dll;$(GameDir)/MelonLoader/**/HarmonyLib.dll;$(GameDir)/MelonLoader/**/HarmonyX.dll" />

    <Reference Include="$(GameAssemblyDir)/Assembly-CSharp*.dll"><Private>false</Private></Reference>
    <Reference Include="@(_MelonLoaderDll)"><Private>false</Private></Reference>
    <Reference Include="@(_HarmonyDll)"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)/MelonLoader/Managed/Il2Cpp*.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)/MelonLoader/Managed/Unhollower*.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)/MelonLoader/Managed/Unity*.dll"><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="CheckLocalGamePath" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameDir)' == ''" Text="Set GameDir in ModCode/Local.props (copy ModCode/Local.props.example first)." />
    <Error Condition="'$(GameDir)' != '' And !Exists('$(GameAssemblyDir)/Assembly-CSharp.dll')" Text="Assembly-CSharp.dll not found in MelonLoader/Managed or MelonLoader/Il2CppAssemblies under GameDir. Check the installation path." />
    <Error Condition="'$(GameDir)' != '' And '@(_MelonLoaderDll)' == ''" Text="MelonLoader.dll was not found under $(GameDir)/MelonLoader. Check your MelonLoader installation and run the DLL discovery command in docs/build-troubleshooting.md." />
    <Error Condition="'$(GameDir)' != '' And '@(_HarmonyDll)' == ''" Text="Harmony (0Harmony.dll, HarmonyLib.dll or HarmonyX.dll) was not found under $(GameDir)/MelonLoader. Run the DLL discovery command in docs/build-troubleshooting.md." />
  </Target>
</Project>
